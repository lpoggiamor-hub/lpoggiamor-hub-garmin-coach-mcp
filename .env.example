# Obligatorio para /mcp. Genera uno con: openssl rand -hex 32
MCP_API_TOKEN=
MCP_READ_ONLY=1

# Autenticacion Garmin basada en tokens. No guardes email ni contraseña aqui.
GARMIN_TOKENS_JSON=
GARMIN_TIMEZONE=America/Santiago
GARMIN_LANGUAGE=es
CACHE_MINUTES=10
ACTIVITY_LIMIT=20

# Re-login web wizard (mobile-friendly /login flow)
# Genera un token aleatorio largo: openssl rand -hex 32
ADMIN_TOKEN=
# Railway API token (Account → Tokens) para que /login actualice GARMIN_TOKENS_JSON solo
RAILWAY_API_TOKEN=
# Las tres siguientes las inyecta Railway automáticamente en cada deploy:
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=
# Sincroniza el OAuth1 maestro a Railway si rota (poco frecuente).
AUTO_SYNC_TOKENS=1
AUTO_SYNC_INTERVAL_SECONDS=43200
